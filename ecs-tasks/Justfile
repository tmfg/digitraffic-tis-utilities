# read env variables - mainly localstack override - from .env:
set dotenv-load := true

# Lists available Just recipes
default:
  @just --list --justfile {{justfile()}}

# Build rule container identified by its name.
build rulename:
  docker build --build-arg GITHUB_SHA="$(git rev-parse HEAD)" --platform linux/amd64 -t ecs-task-{{rulename}} -f ./{{rulename}}/Dockerfile .

# Execute rule container identified by its name.
[private]
execute rulename:
  docker run --platform linux/amd64 \
    --rm \
    --read-only \
    --network=tis_tis \
    -v $(pwd)/app-tmp:/app/tmp \
    -e LOCALSTACK_ENDPOINT_URL=http://localstack:4566 \
    ecs-task-{{rulename}}

# Run specific rule identified by its directory name
run rule: (build rule) (execute rule)

# Shell into rule container. Useful for debugging.
shell rulename: (build rulename)
  docker run --platform linux/amd64 \
    --rm \
    -it \
    --entrypoint /bin/bash \
    ecs-task-{{rulename}}

# Run wrapper unit tests (no AWS needed). Creates a virtualenv in .venv-wrapper-tests.
test:
  python3 -m venv .venv-wrapper-tests
  .venv-wrapper-tests/bin/pip install -q -r wrapper-tests/requirements-dev.txt
  .venv-wrapper-tests/bin/python -m pytest wrapper-tests
